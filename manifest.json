{
  "manifest_version": 3,
  "name": "ReadAI",
  "version": "1.0",
  "description": "Highlight text to get AI explanations with context",

  "browser_specific_settings": {
    "gecko": {
      "id": "readai@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
            "required": ["none"],
            "optional": []
          }
    }
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://raw.githubusercontent.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],

  "commands": {
    "explain-selection": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Explain highlighted text"
    }
  },

  "icons": {
    "192": "icons/icon.png"
  }
}